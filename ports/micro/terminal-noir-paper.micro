# Terminal Noir (light) for micro. https://terminalnoir.web.app
# Generated by scripts/build from palette/palette.json.

color-link default "#1C1A17,#FBFAF7"
color-link comment "#5E5A53"
color-link identifier "#0663D0"
color-link identifier.class "#7C4BCB"
color-link identifier.var "#1C1A17"
color-link constant "#8A5300"
color-link constant.number "#8A5300"
color-link constant.bool "#8A5300"
color-link constant.string "#0B7656"
color-link constant.string.char "#0B7656"
color-link constant.specialChar "#0A7187"
color-link statement "#865700"
color-link symbol "#1C1A17"
color-link symbol.operator "#1C1A17"
color-link symbol.brackets "#1C1A17"
color-link symbol.tag "#CB1B2A"
color-link preproc "#7C4BCB"
color-link type "#7C4BCB"
color-link type.keyword "#865700"
color-link special "#0A7187"
color-link underlined "#0663D0"
color-link error "bold #B42318"
color-link todo "bold #8A5300"
color-link hlsearch "#FBFAF7,#8A5300"
color-link statusline "#1C1A17,#E9E6DF"
color-link statusline.inactive "#5E5A53,#F1EFEA"
color-link tabbar "#5E5A53,#F1EFEA"
color-link tabbar.active "#FBFAF7,#865700"
color-link indent-char "#DCD8CF"
color-link line-number "#88837A,#FBFAF7"
color-link current-line-number "#865700,#F1EFEA"
color-link cursor-line "#F1EFEA"
color-link color-column "#F1EFEA"
color-link gutter-error "#B42318"
color-link gutter-warning "#8A5300"
color-link diff-added "#0B7656"
color-link diff-modified "#8A5300"
color-link diff-deleted "#B42318"
color-link match-brace "#FBFAF7,#865700"
color-link selection "#1C1A17,#D6D2C8"
color-link divider "#88837A,#FBFAF7"
color-link scrollbar "#88837A,#F1EFEA"
color-link message "#1C1A17"
color-link error-message "#B42318"

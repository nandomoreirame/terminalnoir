# Terminal Noir (dark) for micro. https://terminalnoir.web.app
# Generated by scripts/build from palette/palette.json.

color-link default "#F4F4F5,#0B0B0C"
color-link comment "#A1A1AA"
color-link identifier "#79C0FF"
color-link identifier.class "#D2A8FF"
color-link identifier.var "#F4F4F5"
color-link constant "#FACF9E"
color-link constant.number "#FACF9E"
color-link constant.bool "#FACF9E"
color-link constant.string "#34D399"
color-link constant.string.char "#34D399"
color-link constant.specialChar "#56D4DD"
color-link statement "#F5A623"
color-link symbol "#F4F4F5"
color-link symbol.operator "#F4F4F5"
color-link symbol.brackets "#F4F4F5"
color-link symbol.tag "#FF7B72"
color-link preproc "#D2A8FF"
color-link type "#D2A8FF"
color-link type.keyword "#F5A623"
color-link special "#56D4DD"
color-link underlined "#79C0FF"
color-link error "bold #FFB7B0"
color-link todo "bold #FACF9E"
color-link hlsearch "#0B0B0C,#FACF9E"
color-link statusline "#F4F4F5,#18181B"
color-link statusline.inactive "#A1A1AA,#121214"
color-link tabbar "#A1A1AA,#121214"
color-link tabbar.active "#0B0B0C,#F5A623"
color-link indent-char "#222226"
color-link line-number "#6B6B74,#0B0B0C"
color-link current-line-number "#F5A623,#121214"
color-link cursor-line "#121214"
color-link color-column "#121214"
color-link gutter-error "#FFB7B0"
color-link gutter-warning "#FACF9E"
color-link diff-added "#34D399"
color-link diff-modified "#FACF9E"
color-link diff-deleted "#FFB7B0"
color-link match-brace "#0B0B0C,#F5A623"
color-link selection "#F4F4F5,#52525B"
color-link divider "#64646B,#0B0B0C"
color-link scrollbar "#64646B,#121214"
color-link message "#F4F4F5"
color-link error-message "#FFB7B0"

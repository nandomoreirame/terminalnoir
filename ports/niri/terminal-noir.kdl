// Terminal Noir for niri. https://terminalnoir.web.app
// Generated by scripts/build from palette/palette.json.
// Include it from config.kdl, or copy the blocks into your layout {}.
layout {
    focus-ring {
        width 3
        active-color "#f5a623cc"
        inactive-color "#3f3f46"
        urgent-color "#ffb7b0"
    }

    border {
        off
        width 3
        active-color "#f5a623cc"
        inactive-color "#3f3f46"
        urgent-color "#ffb7b0"
    }

    insert-hint {
        color "#f5a62380"
    }
}

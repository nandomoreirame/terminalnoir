---
import { Icon } from 'astro-icon/components';
import { getI18n } from '../i18n/context';
import type { UiKey } from '../i18n/ui';
import type { Port } from '../lib/ports';

interface Props {
  port: Port;
}

const { port } = Astro.props;
const { t, path } = getI18n(Astro.currentLocale);
---

<li data-port={`${port.name} ${port.slug} ${port.category}`.toLowerCase()}>
  <a
    href={path(`/ports/${port.slug}`)}
    class="group flex h-full flex-col justify-between gap-6 rounded border border-hairline bg-raised p-5 transition-colors duration-150 hover:border-accent focus-visible:border-accent"
  >
    <span class="flex items-start justify-between gap-4">
      <span class="font-mono text-sm font-semibold text-fg transition-colors group-hover:text-accent">
        {port.name}
      </span>
      <Icon name={port.icon} class="size-7 shrink-0 text-accent" aria-hidden="true" />
    </span>
    <span class="flex items-center justify-between gap-2 font-mono text-[11px] text-faint">
      <span>{t(`category.${port.category}`)}</span>
      <span class="rounded border border-hairline bg-elevated px-2 py-0.5 text-[10px] text-muted">
        {port.variants.map(v => t(`variant.${v}` as UiKey)).join(' · ')}
      </span>
    </span>
  </a>
</li>

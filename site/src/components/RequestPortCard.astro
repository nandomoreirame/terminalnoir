---
import { Icon } from 'astro-icon/components';
import { getI18n } from '../i18n/context';
import { REPO_URL } from '../lib/site';

const { t } = getI18n(Astro.currentLocale);
---

<li>
  <a
    href={`${REPO_URL}/issues/new`}
    class="group flex h-full flex-col justify-between gap-6 rounded border border-dashed border-outline p-5 transition-colors duration-150 hover:border-accent focus-visible:border-accent"
  >
    <span class="flex items-start justify-between gap-4">
      <span class="font-mono text-sm font-semibold text-fg transition-colors group-hover:text-accent">
        {t('ports.requestTitle')}
      </span>
      <Icon
        name="lucide:plus"
        class="size-7 shrink-0 text-muted transition-colors group-hover:text-accent"
        aria-hidden="true"
      />
    </span>
    <span class="flex items-center justify-between gap-2 font-mono text-[11px] text-accent">
      <span>{t('ports.requestCta')}</span>
      <Icon name="lucide:arrow-right" class="size-3.5" aria-hidden="true" />
    </span>
  </a>
</li>

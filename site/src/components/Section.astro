---
// A full-width band with a hairline under it, as in the Stitch design.
interface Props {
  id?: string;
  last?: boolean;
  class?: string;
}

const { id, last = false, class: className } = Astro.props;
---

<section id={id} class:list={[!last && 'border-b border-hairline']}>
  <div class:list={['mx-auto max-w-5xl px-6 py-16 sm:py-20', className]}>
    <slot />
  </div>
</section>

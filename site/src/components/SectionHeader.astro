---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  level?: 1 | 2;
  id?: string;
}

const { eyebrow, title, description, level = 2, id } = Astro.props;
const Heading = level === 1 ? 'h1' : 'h2';
---

<div class="mb-10 flex flex-col justify-between gap-6 md:flex-row md:items-end">
  <div class="space-y-2">
    <p class="eyebrow">{eyebrow}</p>
    <Heading id={id} class="font-serif text-3xl text-fg sm:text-4xl">{title}</Heading>
    {description && <p class="max-w-xl text-sm text-muted">{description}</p>}
  </div>
  <slot />
</div>

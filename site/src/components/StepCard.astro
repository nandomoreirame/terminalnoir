---
interface Props {
  step: string;
  title: string;
}

const { step, title } = Astro.props;
---

<li class="space-y-3 rounded border border-hairline bg-raised p-6">
  <p class="font-mono text-xs text-accent uppercase">{step}</p>
  <h3 class="font-serif text-xl text-fg">{title}</h3>
  <p class="text-sm leading-relaxed text-muted"><slot /></p>
</li>

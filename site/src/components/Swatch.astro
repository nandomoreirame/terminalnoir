---
import { Icon } from 'astro-icon/components';
import { getI18n } from '../i18n/context';
import type { UiKey } from '../i18n/ui';
import type { Swatch } from '../lib/palette';

interface Props {
  swatch: Swatch;
  // Accent swatches print their name in their own color, as in the Stitch design.
  tinted?: boolean;
}

const { swatch, tinted = false } = Astro.props;
const { t } = getI18n(Astro.currentLocale);
---

<li>
  <button
    type="button"
    data-copy={swatch.hex}
    aria-label={t('palette.copySwatch', { role: swatch.role, hex: swatch.hex })}
    class="group w-full rounded border border-hairline bg-raised p-3 text-left transition-colors hover:border-accent"
  >
    <span class="mb-2.5 block h-14 w-full rounded border border-hairline" style={`background-color:${swatch.hex}`}></span>
    <span
      class:list={['flex items-center justify-between font-mono text-xs', !tinted && 'text-fg']}
      style={tinted ? `color:${swatch.hex}` : undefined}
    >
      <span>{swatch.role}</span>
      <Icon
        name="lucide:copy"
        class="size-3 text-faint opacity-0 transition-opacity group-hover:opacity-100 group-focus-visible:opacity-100"
        aria-hidden="true"
      />
    </span>
    <span class="block font-mono text-[11px] text-faint">{swatch.hex}</span>
    <span class="mt-1 block text-[10px] text-muted">{t(`role.${swatch.role}` as UiKey)}</span>
  </button>
</li>

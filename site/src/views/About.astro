---
import CtaBox from '../components/CtaBox.astro';
import Section from '../components/Section.astro';
import SectionHeader from '../components/SectionHeader.astro';
import StepCard from '../components/StepCard.astro';
import { getI18n } from '../i18n/context';
import Layout from '../layouts/Layout.astro';

const { t } = getI18n(Astro.currentLocale);
const rules = [1, 2, 3] as const;
---

<Layout title={t('about.eyebrow')} description={t('about.metaDescription')}>
  <Section>
    <SectionHeader eyebrow={t('about.eyebrow')} title={t('about.title')} level={1} />
    <div class="max-w-2xl space-y-4 text-muted">
      <p set:html={t('about.p1Html')} />
      <p>{t('about.p2')}</p>
    </div>
  </Section>

  <Section>
    <SectionHeader eyebrow={t('about.principlesEyebrow')} title={t('about.principlesTitle')} />
    <ol class="grid grid-cols-1 gap-6 md:grid-cols-3">
      {
        rules.map(n => (
          <StepCard step={t(`about.rule${n}Label`)} title={t(`about.rule${n}Title`)}>
            {t(`about.rule${n}`)}
          </StepCard>
        ))
      }
    </ol>
  </Section>

  <Section>
    <SectionHeader eyebrow={t('about.creditsEyebrow')} title={t('about.creditsTitle')} />
    <p class="max-w-2xl text-muted" set:html={t('about.creditsHtml')} />
  </Section>

  <Section last>
    <CtaBox />
  </Section>
</Layout>

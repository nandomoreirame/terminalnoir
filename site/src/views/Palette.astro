---
import CopyStatus from '../components/CopyStatus.astro';
import Section from '../components/Section.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Swatch from '../components/Swatch.astro';
import { getI18n } from '../i18n/context';
import type { UiKey } from '../i18n/ui';
import Layout from '../layouts/Layout.astro';
import { ansiColors, swatchGroups, VARIANTS } from '../lib/palette';

const { t } = getI18n(Astro.currentLocale);
const LABEL = { dark: t('palette.dark'), light: t('palette.light') } as const;
const pad = (n: number) => String(n).padStart(2, '0');
const ansiName = (name: string) => {
  const base = name.replace(/^bright /, '');
  const translated = t(`ansi.${base}` as UiKey);
  return name.startsWith('bright ') ? t('ansi.bright', { name: translated }) : translated;
};
---

<Layout title={t('palette.title')} description={t('palette.metaDescription')}>
  <div class="palette">
    <Section last>
      <SectionHeader
        eyebrow={t('palette.eyebrow')}
        title={t('palette.title')}
        level={1}
        description={t('palette.description')}
      >
        <fieldset class="inline-flex self-start rounded border border-hairline bg-raised p-1 font-mono text-xs md:self-auto">
          <legend class="sr-only">{t('palette.variant')}</legend>
          {
            VARIANTS.map((v, i) => (
              <label class="variant-option cursor-pointer rounded border border-transparent px-3 py-1 whitespace-nowrap text-muted">
                <input class="sr-only" type="radio" name="variant" id={`v-${v}`} value={v} checked={i === 0} />
                {LABEL[v]}
              </label>
            ))
          }
        </fieldset>
      </SectionHeader>

      {
        VARIANTS.map(v => (
          <div data-variant={v} class="space-y-10">
            {swatchGroups(v).map((group, i) => {
              const title = t(`palette.group.${group.id}` as UiKey);
              return (
                <section aria-label={`${LABEL[v]}: ${title}`} class="space-y-3">
                  <div class="flex items-center justify-between gap-4">
                    <h2 class="font-mono text-xs tracking-wider text-muted uppercase">
                      {pad(i + 1)} / {title}
                    </h2>
                    {i === 0 && <span class="font-mono text-[11px] text-faint">{t('palette.clickToCopy')}</span>}
                  </div>
                  <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
                    {group.items.map(s => (
                      <Swatch swatch={s} tinted={group.id === 'accent' && s.name !== 'onPrimary'} />
                    ))}
                  </ul>
                </section>
              );
            })}

            <section aria-label={`${LABEL[v]}: ANSI`} class="rounded border border-hairline bg-raised p-4">
              <div class="mb-3 flex items-center justify-between gap-4">
                <h2 class="font-mono text-xs text-muted">04 / {t('palette.ansiTitle')}</h2>
                <span class="font-mono text-[11px] whitespace-nowrap text-faint">ANSI 00 – 15</span>
              </div>
              <ul class="grid grid-cols-8 gap-1.5">
                {ansiColors(v).map(a => (
                  <li class="text-center">
                    <button
                      type="button"
                      data-copy={a.hex}
                      title={`ANSI ${a.index}: ${ansiName(a.name)} (${a.hex})`}
                      aria-label={t('palette.copyAnsi', { index: a.index, name: ansiName(a.name), hex: a.hex })}
                      class="block h-8 w-full rounded-sm border border-hairline transition-transform hover:scale-105"
                      style={`background-color:${a.hex}`}
                    />
                    <span class="font-mono text-[10px] text-faint">{pad(a.index)}</span>
                  </li>
                ))}
              </ul>
            </section>
          </div>
        ))
      }
    </Section>
  </div>

  <CopyStatus />

  <style>
    .palette:has(#v-dark:checked) [data-variant='light'],
    .palette:has(#v-light:checked) [data-variant='dark'] {
      display: none;
    }
    .variant-option:has(input:checked) {
      border-color: var(--color-outline);
      background: var(--color-elevated);
      color: var(--color-accent);
    }
    .variant-option:has(input:focus-visible) {
      outline: 2px solid var(--color-accent);
      outline-offset: 2px;
    }
  </style>
</Layout>

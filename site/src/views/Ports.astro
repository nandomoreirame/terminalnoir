---
import { Icon } from 'astro-icon/components';
import PortCard from '../components/PortCard.astro';
import RequestPortCard from '../components/RequestPortCard.astro';
import Section from '../components/Section.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { getI18n } from '../i18n/context';
import Layout from '../layouts/Layout.astro';
import { getPorts } from '../lib/ports';

const { locale, t } = getI18n(Astro.currentLocale);
const ports = getPorts(locale);
const count = ports.length;
---

<Layout title={t('ports.title')} description={t('ports.metaDescription')}>
  <Section last>
    <SectionHeader eyebrow={t('ports.eyebrow')} title={t('ports.title')} level={1} description={t('ports.description')}>
      <div class="flex items-center gap-3">
        <div class="relative w-full sm:w-64">
          <Icon
            name="lucide:search"
            class="pointer-events-none absolute top-1/2 left-3 size-4 -translate-y-1/2 text-faint"
            aria-hidden="true"
          />
          <label for="port-search" class="sr-only">{t('ports.searchLabel')}</label>
          <input
            id="port-search"
            type="search"
            autocomplete="off"
            placeholder={t('ports.searchPlaceholder', { count })}
            class="w-full rounded border border-hairline bg-raised py-1.5 pr-3 pl-9 font-mono text-xs text-fg transition-colors placeholder:text-faint focus:border-accent"
          />
        </div>
        <span class="rounded border border-hairline bg-elevated px-2.5 py-1.5 font-mono text-xs whitespace-nowrap text-muted">
          {t('ports.count', { count })}
        </span>
      </div>
    </SectionHeader>

    <ul id="ports-grid" class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {ports.map(port => <PortCard port={port} />)}
      <RequestPortCard />
    </ul>
    <p id="no-results" class="mt-8 hidden font-mono text-sm text-muted">{t('ports.noResults')}</p>
    <p
      id="search-status"
      class="sr-only"
      aria-live="polite"
      data-one={t('ports.shownOne')}
      data-many={t('ports.shownMany')}
    >
    </p>
  </Section>

  <script>
    const input = document.getElementById('port-search') as HTMLInputElement | null;
    const status = document.getElementById('search-status');
    const empty = document.getElementById('no-results');
    const cards = [...document.querySelectorAll<HTMLElement>('[data-port]')];

    input?.addEventListener('input', () => {
      const query = input.value.trim().toLowerCase();
      let shown = 0;
      for (const card of cards) {
        const match = !query || (card.dataset.port ?? '').includes(query);
        card.hidden = !match;
        if (match) shown++;
      }
      empty?.classList.toggle('hidden', shown > 0);
      if (status) {
        const template = (shown === 1 ? status.dataset.one : status.dataset.many) ?? '';
        status.textContent = template.replace('{count}', String(shown));
      }
    });
  </script>
</Layout>
